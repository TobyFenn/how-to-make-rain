    <header class="l-header header-weather" role="banner">
              






  <div  id="block-noaaweatherwidget" class="c-block c-block--provider-noaa-weather c-block--id-noaa-weather-widget-block">

  
  
    

      <div  class="c-block__content">
  
      <form class="weather-widget-form no-weather hide-formatting noaa-weather-widget-form" action="#" method="post" accept-charset="UTF-8">
  <div class="upper">
    <script class="noaa_weather_upper" type="text/x-handlebars-template" >
      
        {{#if nodata}}
          <div class="current-temp"></div>
        {{else}}
          <div class="current-temp" {{#if icon}}style="background-image: url(&quot;/themes/custom/noaa_guswds/images/icons/weather/{{icon}}&quot;)" {{/if}}>{{#if deg}}{{deg}}°{{/if}}</div>
        {{/if}}

        <div class="inner">
          <div class="city icon-location-after">{{#if nodata}}Not Available{{else}}{{city}}{{#if state}}, {{state}}{{/if}}{{/if}}</div>
        </div>
      
    </script>
    <div class="weather-toggle icon-location-after">
      <span class="underline" data-ga="Weather:Find">Find your local weather</span>
    </div>
  </div>
  <div class="lower">
    <div class="close-button" tabindex="0"></div>
    <script class="noaa_weather_lower" type="text/x-handlebars-template" >
      
        <div class="city">{{#if nodata}}Not Available{{else}}{{city}}{{#if state}}, {{state}}{{/if}}{{/if}}</div>
        <div class="forecast-wrapper{{#if pop}} has-precip{{/if}}">
          <div class="upper">
          <div class="inner">
            {{#if nodata}}
              <div class="current-temp"></div>
            {{else}}
              <div class="current-temp" {{#if icon}}style="background-image: url(&quot;/themes/custom/noaa_guswds/images/icons/weather/{{icon}}&quot;)" {{/if}}>{{#if deg}}{{deg}}°{{/if}}</div>
              <div class="label">currently</div>
            {{/if}}
          </div>
          </div>
          {{#if nodata}}
            <a class="not-available" href="/no-data">Why is data not available?</a>
          {{else}}
          <div class="forecast-temp forecast-item"><div class="data">{{maxt}}/{{mint}}° </div><div class="label">high/low</div></div>
          {{#if pop}}<div class="forecast-precip forecast-item"><div class="data">{{pop}}% </div><div class="label">chance of {{precip_type}}</div></div>{{/if}}
          {{#if wspd}}<div class="wind forecast-item"><div class="data">{{#if wdir}}{{wdir}}{{/if}} {{wspd}} </div><div class="label">mph winds</div></div>{{/if}}
        </div>
        <a href="http://forecast.weather.gov/MapClick.php?lat={{lat}}&amp;lon={{lng}}" class="forecast-link{{#if pop}} has-precip{{/if}}" name="edit-forecast" data-ga="Weather:See full forecast">See full local forecast</a>
        {{/if}}
      
    </script>
    <div class="form-wrapper">
      <div class="change">Change location:</div>
      <div class="form-item form-type-textfield form-item-zip">
        <label class="visually-hidden" for="edit-zip" id="zip-label">Enter City, State or ZIP code</label>
        <input placeholder="Enter City, State or ZIP code" class="zip-input form-text" data-ga="Weather:Text field" type="text" id="edit-zip" name="edit-zip" aria-labelledby="zip-label" value="" size="0" maxlength="128">
        <input type="submit" name="edit-submit" value="GO" class="form-submit" data-ga="Weather:Submit button">
      </div>
    </div>
  </div>
</form>

  
      </div>
  
  
  </div>









  
  
    

  
